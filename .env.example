# 复制成 .env 再填真实值：cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，不要把真实密钥提交上来。
# 程序启动时会自动读取：~/.hermes/.env、当前目录 .env、仓库根 .env（已存在的环境变量优先）。

# ---- LLM（不填则回退确定性 RuleBasedBrain，Demo 仍可跑）----
LLM_API_KEY=
LLM_BASE_URL=https://api.xiaomimimo.com/v1
LLM_MODEL=mimo-v2.6-flash

# 兼容回退（仅在 LLM_* 未设置时生效）
# MIMO_API_KEY= / OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ---- Step 18：PostgreSQL / Redis（不填则用 SQLite + 进程内记忆）----
# scripts/dev_services.sh env 会输出下面两行，值形如：
# DATABASE_URL=postgresql://hermes@127.0.0.1:55432/business
# REDIS_URL=redis://127.0.0.1:6399/0
DATABASE_URL=
REDIS_URL=

# ---- 数据库韧性（可选，默认值见 app/store_pg.py）----
# PG_CONNECT_RETRIES=3      # 单次操作的重连次数
# PG_CONNECT_TIMEOUT=2      # 每次连接超时（秒）
# PG_PING_TIMEOUT=1         # /health 探测超时（秒）
# PG_GATE_RETRIES=2         # 请求准入探测重试次数（扛住数据库重启窗口）

# ---- 其他 ----
# 业务库路径（SQLite 模式）
# AGENT_DB_PATH=data/business.db
# 用远程 embedding 做 RAG 检索（默认离线确定性）
# AGENT_RAG_EMBEDDINGS=glm
# 覆盖 Demo 的「今天」，影响 7 天/15 天时效判断
# AGENT_DEMO_TODAY=2026-09-27
