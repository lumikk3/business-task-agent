# Step 20：Agent API 镜像。
# ⚠️ 本机 WSL 内没有 docker，本文件未在本机构建/运行验证过。
FROM python:3.12-slim

WORKDIR /app
ENV PYTHONUNBUFFERED=1 PYTHONPATH=/app

COPY requirements-optional.txt requirements-db.txt ./
RUN pip install --no-cache-dir -r requirements-optional.txt -r requirements-db.txt

COPY app ./app
COPY data ./data
COPY eval ./eval

EXPOSE 8077
# 生产里用 DATABASE_URL / REDIS_URL 切到 Postgres + Redis
CMD ["python", "-m", "uvicorn", "app.api.server:app", "--host", "0.0.0.0", "--port", "8077"]
